# Copy to .env for local development. Never commit .env.
# In production, set the same names in Vercel: Project > Settings > Environment Variables.
# PUBLIC_* values are inlined at build time, so redeploy after changing them.

# --- Contact form (server-side secrets, used by api/contact.ts) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Search engine indexing ---
# Leave empty (or false) while the site still has placeholder content.
# Set to true in Vercel (Production) only at launch.
PUBLIC_ALLOW_INDEXING=false

# --- Optional integrations: render nothing when empty ---
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
