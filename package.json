{
  "name": "hatami-tech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio and blog for hatami.tech (Astro, deployed on Vercel)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "dev:vercel": "pnpm dlx vercel dev",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:links": "node scripts/check-links.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "lighthouse": "pnpm dlx @lhci/cli autorun"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "satori": "^0.52.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "node-html-parser": "^9.0.4",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
