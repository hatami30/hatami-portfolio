---
import { site } from '@/config/site';
import { t } from '@/config/strings';
import { getFeaturedProjects, getPublishedPosts } from '@/lib/content';
import { personJsonLd, websiteJsonLd } from '@/lib/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import PostCard from '@/components/blog/PostCard.astro';
import TextScrollReveal from '@/components/ui/TextScrollReveal.astro';
import BentoGrid from '@/components/ui/BentoGrid.astro';
import LiveFromTheDesk from '@/components/presence/LiveFromTheDesk.astro';
import FaqAccordion from '@/components/ui/FaqAccordion.astro';
import HeroBackground from '@/components/ui/HeroBackground.astro';

const featured = await getFeaturedProjects(3);
const latestPosts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout title={site.role} home jsonLd={[personJsonLd(), websiteJsonLd()]}>
  <div class="relative flex min-h-screen flex-col justify-center overflow-hidden">
    <HeroBackground />

    <Container class="relative z-10 pt-28 sm:pt-32 pb-16 sm:pb-24 lg:pb-28">
      <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <!-- Left: Editorial identity -->
        <div class="flex flex-col items-start">
          <div class="border-border/80 bg-surface/60 mb-6 inline-flex items-center gap-2.5 rounded-full border px-3.5 py-1 font-mono text-xs text-muted shadow-xs backdrop-blur-md">
            <span class="relative flex h-2 w-2 shrink-0">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            <span>{t.home.statusAvailable}</span>
          </div>

          <h1 class="flex flex-col">
            <span class="text-base font-medium tracking-wide text-muted sm:text-lg">
              {t.home.greeting}
            </span>
            <span class="mt-1 text-4xl font-extrabold leading-[1.05] tracking-tight text-accent sm:text-5xl lg:text-6xl">
              {site.name}
            </span>
          </h1>

          <h2 class="mt-5 text-xl font-medium leading-snug tracking-tight text-fg sm:text-2xl">
            {site.role}
          </h2>

          <p class="mt-5 max-w-[52ch] text-base leading-relaxed text-muted sm:text-lg">
            {site.description}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3.5">
            <Button href="/projects">{t.home.ctaProjects}</Button>
            <Button href="/contact" variant="secondary">
              {t.home.ctaContact}
            </Button>
          </div>
        </div>

        <!-- Right: Speech bubble with live micro-telemetry -->
        <div class="relative w-full lg:mt-6">
          <!-- Bubble tail (desktop: pointing left toward the intro) -->
          <svg
            class="absolute -left-9 bottom-1 hidden h-12 w-12 text-surface lg:block"
            viewBox="0 0 32 32"
            aria-hidden="true"
          >
            <path
              d="M32 0v24C24 24 16 32 0 32C12 28 20 20 24 12C28 4 30 0 32 0Z"
              fill="currentColor"
            />
            <path
              d="M32 24C24 24 16 32 0 32C12 28 20 20 24 12"
              fill="none"
              stroke="var(--border)"
              stroke-width="1"
              vector-effect="non-scaling-stroke"
              stroke-linecap="round"
            />
          </svg>
          <!-- Bubble tail (mobile: pointing up toward the intro) -->
          <svg
            class="absolute -top-[35px] left-3 h-12 w-12 text-surface lg:hidden"
            viewBox="0 0 32 32"
            aria-hidden="true"
          >
            <path
              d="M0 32h24C24 24 32 16 32 0C28 12 20 20 12 24C4 28 0 30 0 32Z"
              fill="currentColor"
            />
            <path
              d="M24 32C24 24 32 16 32 0C28 12 20 20 12 24"
              fill="none"
              stroke="var(--border)"
              stroke-width="1"
              vector-effect="non-scaling-stroke"
              stroke-linecap="round"
            />
          </svg>

          <div class="relative rounded-3xl rounded-tl-none border border-border/80 bg-surface px-6 py-6 shadow-sm sm:px-7 sm:py-7 lg:rounded-tl-3xl lg:rounded-bl-none">
            <p class="text-[15px] font-medium leading-relaxed tracking-wide text-fg sm:text-base">
              {t.home.speechBubble}
            </p>
          </div>
        </div>
      </div>
    </Container>
  </div>

  <TextScrollReveal />

  <Container>
    <BentoGrid />
  </Container>

  {featured.length > 0 && (
    <Container class="py-12">
      <section aria-labelledby="featured-title">
        <div class="mb-8 flex flex-wrap items-baseline justify-between gap-2 border-b border-border/60 pb-4">
          <div>
            <h2 id="featured-title" class="text-2xl font-bold tracking-tight">
              {t.home.featuredProjects}
            </h2>
            <p class="text-muted mt-1 text-sm">{t.projects.intro}</p>
          </div>
          <a
            href="/projects"
            class="text-accent text-sm font-medium hover:underline underline-offset-4"
          >
            {t.home.allProjects} →
          </a>
        </div>
        <ul class="grid gap-6 sm:grid-cols-2">
          {featured.map((project) => (
            <li class="min-w-0">
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      </section>
    </Container>
  )}

  {latestPosts.length > 0 && (
    <Container class="py-12">
      <section aria-labelledby="latest-title">
        <div class="mb-8 flex flex-wrap items-baseline justify-between gap-2 border-b border-border/60 pb-4">
          <div>
            <h2 id="latest-title" class="text-2xl font-bold tracking-tight">
              {t.home.latestPosts}
            </h2>
            <p class="text-muted mt-1 text-sm">{t.blog.intro}</p>
          </div>
          <a
            href="/blog"
            class="text-accent text-sm font-medium hover:underline underline-offset-4"
          >
            {t.home.allPosts} →
          </a>
        </div>
        <div class="divide-y divide-border/60">
          {latestPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    </Container>
  )}

  <Container>
    <LiveFromTheDesk />
  </Container>

  <Container>
    <FaqAccordion />
  </Container>

  <Container class="py-20">
    <section class="card-interactive relative overflow-hidden rounded-3xl border border-border/80 bg-surface/80 p-8 sm:p-14 text-center backdrop-blur-md shadow-xs">
      <div class="relative z-10">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t.home.closingTitle}</h2>
        <p class="text-muted mx-auto mt-4 max-w-[52ch] text-base sm:text-lg leading-relaxed">
          {t.home.closingText}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href="/contact">{t.home.ctaContact}</Button>
        </div>
      </div>
    </section>
  </Container>
</BaseLayout>
