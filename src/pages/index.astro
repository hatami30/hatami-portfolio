---
import { site } from '@/config/site';
import { t } from '@/config/strings';
import { getFeaturedProjects, getPublishedPosts } from '@/lib/content';
import { personJsonLd, websiteJsonLd } from '@/lib/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import PostCard from '@/components/blog/PostCard.astro';
import TextScrollReveal from '@/components/ui/TextScrollReveal.astro';
import BentoGrid from '@/components/ui/BentoGrid.astro';
import LiveFromTheDesk from '@/components/presence/LiveFromTheDesk.astro';
import FaqAccordion from '@/components/ui/FaqAccordion.astro';
import HeroBackground from '@/components/ui/HeroBackground.astro';
import HeroOrbit from '@/components/ui/HeroOrbit.astro';

const featured = await getFeaturedProjects(3);
const latestPosts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout title={site.role} home jsonLd={[personJsonLd(), websiteJsonLd()]}>
  <div class="relative min-h-screen overflow-hidden pt-20">
    <HeroBackground />
    <HeroOrbit />

    <Container class="relative z-10 flex min-h-[calc(100vh-8rem)] flex-col justify-center py-12 lg:py-0">
      <!-- Availability: in flow on mobile, pinned to the top-centre on desktop -->
      <div class="z-20 mb-8 flex justify-center lg:absolute lg:top-32 lg:right-0 lg:left-0 lg:mb-0">
        <div class="border-border/80 bg-surface/70 inline-flex items-center gap-2 rounded-full border px-4 py-2 shadow-sm backdrop-blur-md">
          <span class="relative flex h-2 w-2 shrink-0">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          <span class="text-fg text-xs font-medium sm:text-sm">{t.home.statusAvailable}</span>
        </div>
      </div>

      <div class="flex w-full flex-col items-center justify-between gap-8 lg:flex-row">
        <!-- Left: editorial identity, pulled up so the name sits on the optical centre -->
        <div class="z-10 flex flex-col items-center text-center lg:-mt-20 lg:w-6/12 lg:items-start lg:text-left">
          <h1 class="mb-4 flex flex-col items-center lg:items-start">
            <span class="text-fg mb-2 text-3xl font-extrabold tracking-tight sm:text-4xl">
              {t.home.greeting}
            </span>
            <span class="text-accent text-4xl leading-[1.15] font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
              {site.name}
            </span>
          </h1>

          <h2 class="text-muted mt-2 max-w-lg text-xl font-medium tracking-tight sm:text-2xl md:text-3xl">
            {t.home.taglineLead}{' '}
            <span class="text-accent block font-bold">{t.home.taglineHighlight}</span>
          </h2>
        </div>

        <!-- Mobile only: the orbit centrepiece needs headroom above the bubble -->
        <div class="pointer-events-none h-[260px] w-full sm:h-[320px] lg:hidden"></div>

        <!-- Right: speech bubble and CTAs, dropped to sit below the orbit core -->
        <div class="z-10 flex w-full flex-col items-center text-center lg:mt-32 lg:w-5/12 lg:items-start lg:text-left">
          <div class="relative mb-10 flex w-full justify-center lg:justify-start">
            <!-- Bubble tail (desktop: pointing left toward the intro) -->
            <svg
              class="text-surface absolute bottom-1 -left-9 hidden h-12 w-12 lg:block"
              viewBox="0 0 32 32"
              aria-hidden="true"
            >
              <path
                d="M32 0v24C24 24 16 32 0 32C12 28 20 20 24 12C28 4 30 0 32 0Z"
                fill="currentColor"
              />
              <path
                d="M32 24C24 24 16 32 0 32C12 28 20 20 24 12"
                fill="none"
                stroke="var(--border)"
                stroke-width="1"
                vector-effect="non-scaling-stroke"
                stroke-linecap="round"
              />
            </svg>
            <!-- Bubble tail (mobile: pointing up toward the intro) -->
            <svg
              class="text-surface absolute -top-[35px] left-3 h-12 w-12 lg:hidden"
              viewBox="0 0 32 32"
              aria-hidden="true"
            >
              <path
                d="M0 32h24C24 24 32 16 32 0C28 12 20 20 12 24C4 28 0 30 0 32Z"
                fill="currentColor"
              />
              <path
                d="M24 32C24 24 32 16 32 0C28 12 20 20 12 24"
                fill="none"
                stroke="var(--border)"
                stroke-width="1"
                vector-effect="non-scaling-stroke"
                stroke-linecap="round"
              />
            </svg>

            <div class="border-border/80 bg-surface relative inline-block w-fit max-w-[90%] rounded-[32px] rounded-tl-none border px-6 py-4 text-left shadow-sm sm:max-w-md lg:rounded-tl-[32px] lg:rounded-bl-none">
              <!-- Travelling hairline that traces the bubble edge. One accent, one element. -->
              <div class="bubble-shimmer" aria-hidden="true"></div>
              <p class="text-fg relative z-10 text-[15px] leading-relaxed font-medium tracking-wide sm:text-base">
                <span class="hidden sm:inline">{t.home.speechBubble}</span>
                <span class="sm:hidden">{t.home.speechBubbleMobile}</span>
              </p>
            </div>
          </div>

          <div class="flex w-full flex-col gap-4 px-4 sm:w-auto sm:flex-row sm:gap-5 lg:flex-col lg:px-0">
            <Button href="/projects" size="lg" shape="pill" class="w-full sm:w-auto">
              {t.home.ctaProjects}
            </Button>
            <Button
              href="/contact"
              variant="secondary"
              size="lg"
              shape="pill"
              class="w-full sm:w-auto"
            >
              {t.home.ctaContact}
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </div>

  <TextScrollReveal />

  <Container>
    <BentoGrid />
  </Container>

  {featured.length > 0 && (
    <Container class="py-12">
      <section aria-labelledby="featured-title">
        <div class="mb-8 flex flex-wrap items-baseline justify-between gap-2 border-b border-border/60 pb-4">
          <div>
            <h2 id="featured-title" class="text-2xl font-bold tracking-tight">
              {t.home.featuredProjects}
            </h2>
            <p class="text-muted mt-1 text-sm">{t.projects.intro}</p>
          </div>
          <a
            href="/projects"
            class="text-accent text-sm font-medium hover:underline underline-offset-4"
          >
            {t.home.allProjects} →
          </a>
        </div>
        <ul class="grid gap-6 sm:grid-cols-2">
          {featured.map((project) => (
            <li class="min-w-0">
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      </section>
    </Container>
  )}

  {latestPosts.length > 0 && (
    <Container class="py-12">
      <section aria-labelledby="latest-title">
        <div class="mb-8 flex flex-wrap items-baseline justify-between gap-2 border-b border-border/60 pb-4">
          <div>
            <h2 id="latest-title" class="text-2xl font-bold tracking-tight">
              {t.home.latestPosts}
            </h2>
            <p class="text-muted mt-1 text-sm">{t.blog.intro}</p>
          </div>
          <a
            href="/blog"
            class="text-accent text-sm font-medium hover:underline underline-offset-4"
          >
            {t.home.allPosts} →
          </a>
        </div>
        <div class="divide-y divide-border/60">
          {latestPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    </Container>
  )}

  <Container>
    <LiveFromTheDesk />
  </Container>

  <Container>
    <FaqAccordion />
  </Container>

  <Container class="py-20">
    <section class="card-interactive relative overflow-hidden rounded-3xl border border-border/80 bg-surface/80 p-8 sm:p-14 text-center backdrop-blur-md shadow-xs">
      <div class="relative z-10">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t.home.closingTitle}</h2>
        <p class="text-muted mx-auto mt-4 max-w-[52ch] text-base sm:text-lg leading-relaxed">
          {t.home.closingText}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href="/contact">{t.home.ctaContact}</Button>
        </div>
      </div>
    </section>
  </Container>
</BaseLayout>

<style>
  /*
   * Hairline that travels once around the speech bubble, then rests. The mask keeps the
   * gradient on the 1px padding box only, so it reads as a moving border highlight.
   */
  .bubble-shimmer {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 1px;
    border-radius: inherit;
    pointer-events: none;
    /* Fallback for engines without @property: keeps the highlight off-canvas. */
    --bubble-x: 100%;
    background-image: linear-gradient(
      -75deg,
      transparent calc(var(--bubble-x) + 20%),
      color-mix(in oklab, var(--accent) 55%, transparent) calc(var(--bubble-x) + 25%),
      transparent calc(var(--bubble-x) + 100%)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    animation: bubble-shimmer 8s ease-in-out infinite;
  }

  @keyframes bubble-shimmer {
    0% {
      --bubble-x: 100%;
    }
    55%,
    100% {
      --bubble-x: -100%;
    }
  }

  @property --bubble-x {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble-shimmer {
      animation: none;
      opacity: 0;
    }
  }
</style>
