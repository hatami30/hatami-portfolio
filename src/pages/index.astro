---
import { site } from '@/config/site';
import { t } from '@/config/strings';
import { getFeaturedProjects, getPublishedPosts } from '@/lib/content';
import { personJsonLd, websiteJsonLd } from '@/lib/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import PostCard from '@/components/blog/PostCard.astro';
import CodingPresence from '@/components/presence/CodingPresence.astro';
import TextScrollReveal from '@/components/ui/TextScrollReveal.astro';
import BentoGrid from '@/components/ui/BentoGrid.astro';
import FaqAccordion from '@/components/ui/FaqAccordion.astro';
import HeroBackground from '@/components/ui/HeroBackground.astro';

const featured = await getFeaturedProjects(3);
const latestPosts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout title={site.role} home jsonLd={[personJsonLd(), websiteJsonLd()]}>
  <div class="relative min-h-screen flex flex-col justify-center overflow-hidden">
    <HeroBackground />

    <Container class="relative z-10 pt-28 sm:pt-32 pb-16 sm:pb-24 lg:pb-28">
      <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
        <!-- Floating Status Pill -->
        <div class="mb-6">
          <CodingPresence />
        </div>

        <!-- Main Heading: Name & Role -->
        <h1 class="text-4xl font-extrabold tracking-tight sm:text-6xl lg:text-7xl">{site.name}</h1>
        <p class="mt-4 text-xl font-medium sm:text-2xl md:text-3xl tracking-tight text-accent">
          {site.role}
        </p>

        <!-- Concise Description -->
        <p class="text-muted mt-6 max-w-[58ch] text-base sm:text-lg lg:text-xl leading-relaxed">
          {site.description}
        </p>

        <!-- Call to Action Buttons -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
          <Button href="/projects">{t.home.ctaProjects}</Button>
          <Button href="/contact" variant="secondary">
            {t.home.ctaContact}
          </Button>
        </div>

        <!-- Clean Minimalist Tech Focus Strip -->
        <div class="mt-12 flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 text-xs font-mono text-muted">
          <span class="rounded-full border border-border/60 bg-surface/50 px-3.5 py-1 backdrop-blur-xs transition-colors hover:border-border hover:text-fg">
            TypeScript
          </span>
          <span class="rounded-full border border-border/60 bg-surface/50 px-3.5 py-1 backdrop-blur-xs transition-colors hover:border-border hover:text-fg">
            Astro
          </span>
          <span class="rounded-full border border-border/60 bg-surface/50 px-3.5 py-1 backdrop-blur-xs transition-colors hover:border-border hover:text-fg">
            Tailwind CSS
          </span>
          <span class="rounded-full border border-border/60 bg-surface/50 px-3.5 py-1 backdrop-blur-xs transition-colors hover:border-border hover:text-fg">
            Node.js
          </span>
          <span class="rounded-full border border-border/60 bg-surface/50 px-3.5 py-1 backdrop-blur-xs transition-colors hover:border-border hover:text-fg">
            Distributed Systems
          </span>
          <span class="rounded-full border border-border/60 bg-surface/50 px-3.5 py-1 backdrop-blur-xs transition-colors hover:border-border hover:text-fg">
            Vercel Edge
          </span>
        </div>
      </div>
    </Container>
  </div>

  <TextScrollReveal />

  <Container>
    <BentoGrid />
  </Container>

  {featured.length > 0 && (
    <Container class="py-12">
      <section aria-labelledby="featured-title">
        <div class="mb-8 flex flex-wrap items-baseline justify-between gap-2 border-b border-border/60 pb-4">
          <div>
            <h2 id="featured-title" class="text-2xl font-bold tracking-tight">
              {t.home.featuredProjects}
            </h2>
            <p class="text-muted mt-1 text-sm">{t.projects.intro}</p>
          </div>
          <a
            href="/projects"
            class="text-accent text-sm font-medium hover:underline underline-offset-4"
          >
            {t.home.allProjects} →
          </a>
        </div>
        <ul class="grid gap-6 sm:grid-cols-2">
          {featured.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      </section>
    </Container>
  )}

  {latestPosts.length > 0 && (
    <Container class="py-12">
      <section aria-labelledby="latest-title">
        <div class="mb-8 flex flex-wrap items-baseline justify-between gap-2 border-b border-border/60 pb-4">
          <div>
            <h2 id="latest-title" class="text-2xl font-bold tracking-tight">
              {t.home.latestPosts}
            </h2>
            <p class="text-muted mt-1 text-sm">{t.blog.intro}</p>
          </div>
          <a
            href="/blog"
            class="text-accent text-sm font-medium hover:underline underline-offset-4"
          >
            {t.home.allPosts} →
          </a>
        </div>
        <div class="divide-y divide-border/60">
          {latestPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    </Container>
  )}

  <Container>
    <FaqAccordion />
  </Container>

  <Container class="py-20">
    <section class="card-interactive relative overflow-hidden rounded-3xl border border-border/80 bg-surface/80 p-8 sm:p-14 text-center backdrop-blur-md shadow-xs">
      <div class="relative z-10">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t.home.closingTitle}</h2>
        <p class="text-muted mx-auto mt-4 max-w-[52ch] text-base sm:text-lg leading-relaxed">
          {t.home.closingText}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href="/contact">{t.home.ctaContact}</Button>
        </div>
      </div>
    </section>
  </Container>
</BaseLayout>
