---
import { site } from '@/config/site';
import { t } from '@/config/strings';
import { getPublishedPosts, getTags } from '@/lib/content';
import { breadcrumbJsonLd, isTagIndexable, webPageJsonLd } from '@/lib/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import PostCard from '@/components/blog/PostCard.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';

export async function getStaticPaths() {
  const [posts, tags] = await Promise.all([getPublishedPosts(), getTags()]);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
const heading = t.blog.tagTitle(tag);
const description = t.blog.tagDescription(tag, posts.length, site.name);
const path = `/blog/tag/${tag}`;
const crumbs = [
  { name: t.blog.title, path: '/blog' },
  { name: `#${tag}`, path },
];
---

<BaseLayout
  title={heading}
  description={description}
  noindex={!isTagIndexable(posts.length)}
  jsonLd={[
    webPageJsonLd({ type: 'CollectionPage', name: heading, description, path }),
    breadcrumbJsonLd(crumbs),
  ]}
>
  <Container class="py-12">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{heading}</h1>
    <section aria-labelledby="tag-posts-title" class="mt-8">
      <h2 id="tag-posts-title" class="sr-only">
        {t.home.allPosts}
      </h2>
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </section>
  </Container>
</BaseLayout>
