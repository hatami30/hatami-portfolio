---
import { t } from '@/config/strings';

interface Props {
  text?: string;
  class?: string;
}

const { text = t.manifesto, class: className } = Astro.props;
const words = text.split(' ');
---

<section class:list={['relative z-0', className]} aria-label="Manifesto">
  <div id="scroll-reveal-track" class="relative z-0 h-[220vh]">
    <div class="sticky top-0 flex h-screen w-full items-center justify-center overflow-hidden bg-bg transition-colors duration-300">
      <!-- Flickering Grid canvas background with radial mask -->
      <div
        class="flickering-grid-wrapper absolute inset-0 z-0 h-full w-full opacity-40 dark:opacity-50 pointer-events-none"
        aria-hidden="true"
      >
        <canvas id="flickering-grid-canvas" class="pointer-events-none w-full h-full"></canvas>
      </div>

      <!-- Text Content -->
      <div class="relative z-10 mx-auto max-w-4xl px-4 py-20 select-none">
        <span class="flex flex-wrap justify-center p-5 text-2xl font-bold text-fg/20 md:p-8 md:text-3xl lg:p-10 lg:text-4xl xl:text-5xl text-center leading-snug tracking-tight">
          {words.map((word, idx) => (
            <span class="reveal-word relative mx-1 lg:mx-1.5" data-index={idx}>
              <span class="absolute opacity-30 select-none text-fg/30">{word}</span>
              <span
                class="reveal-word-fill text-fg transition-opacity duration-75"
                style="opacity: 0;"
              >
                {word}
              </span>
            </span>
          ))}
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .flickering-grid-wrapper {
    -webkit-mask-image: radial-gradient(550px circle at center, white, transparent);
    mask-image: radial-gradient(550px circle at center, white, transparent);
  }
</style>

<script>
  function initScrollRevealSection() {
    // 1. Setup Flickering Grid Canvas
    const canvas = document.getElementById('flickering-grid-canvas') as HTMLCanvasElement | null;
    const track = document.getElementById('scroll-reveal-track');
    const wordFills = document.querySelectorAll<HTMLElement>('.reveal-word-fill');

    if (!canvas || !track || wordFills.length === 0) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const squareSize = 4;
    const gridGap = 6;
    const flickerChance = 0.2;
    const maxOpacity = 0.35;
    const colorRgb = '16, 185, 129'; // emerald accent
    const alphaLevels = 8; // opacity buckets for batched canvas fills

    let cols = 0;
    let rows = 0;
    let squares = new Float32Array(0);
    let dpr = 1;
    let animationFrameId: number | null = null;
    let isIntersecting = false;
    let lastTime = 0;

    function resizeGrid() {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      dpr = window.devicePixelRatio || 1;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;

      cols = Math.ceil(rect.width / (squareSize + gridGap));
      rows = Math.ceil(rect.height / (squareSize + gridGap));
      squares = new Float32Array(cols * rows);

      for (let i = 0; i < squares.length; i++) {
        squares[i] = Math.random() * maxOpacity;
      }
      drawGrid();
    }

    // Resample only a fraction of squares per frame. The per-square chance is
    // scaled by the stride so the perceived flicker rate stays the same while
    // the per-frame work drops by ~4x.
    const updateStride = 4;

    function updateGrid(dt: number) {
      const chance = Math.min(1, flickerChance * dt * updateStride);
      const offset = (Math.random() * updateStride) | 0;
      for (let i = offset; i < squares.length; i += updateStride) {
        if (Math.random() < chance) {
          squares[i] = Math.random() * maxOpacity;
        }
      }
    }

    function drawGrid() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const step = (squareSize + gridGap) * dpr;
      const size = squareSize * dpr;

      // Bucket squares by opacity so we set the fill style a handful of times
      // per frame instead of once per square (the dominant cost was building a
      // fresh `rgba(...)` string for every one of the ~13k squares).
      const paths: Path2D[] = [];
      for (let i = 0; i < alphaLevels; i++) paths.push(new Path2D());

      for (let col = 0; col < cols; col++) {
        for (let row = 0; row < rows; row++) {
          const opacity = squares[col * rows + row];
          if (opacity <= 0.02) continue;
          const level = Math.min(alphaLevels - 1, ((opacity / maxOpacity) * alphaLevels) | 0);
          paths[level].rect(col * step, row * step, size, size);
        }
      }

      for (let i = 0; i < alphaLevels; i++) {
        const alpha = ((i + 0.5) / alphaLevels) * maxOpacity;
        ctx.fillStyle = `rgba(${colorRgb}, ${alpha.toFixed(3)})`;
        ctx.fill(paths[i]);
      }
    }

    function gridLoop(time: number) {
      if (!isIntersecting) return;
      // Cap the grid to ~30fps. It reads as a gentle ambient flicker either way,
      // and halving the draw work leaves main-thread headroom so the scroll
      // reveal can keep its own frame budget on fast scrolls.
      if (time - lastTime < 33) {
        animationFrameId = requestAnimationFrame(gridLoop);
        return;
      }
      const dt = lastTime === 0 ? 0.016 : Math.min(0.1, (time - lastTime) / 1000);
      lastTime = time;

      updateGrid(dt);
      drawGrid();
      animationFrameId = requestAnimationFrame(gridLoop);
    }

    const resizeObserver = new ResizeObserver(() => resizeGrid());
    resizeObserver.observe(canvas);

    const intersectionObserver = new IntersectionObserver(
      ([entry]) => {
        isIntersecting = entry.isIntersecting;
        if (isIntersecting) {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            drawGrid();
            return;
          }
          lastTime = performance.now();
          if (!animationFrameId) {
            animationFrameId = requestAnimationFrame(gridLoop);
          }
        } else if (animationFrameId) {
          cancelAnimationFrame(animationFrameId);
          animationFrameId = null;
        }
      },
      { threshold: 0 },
    );
    intersectionObserver.observe(canvas);

    // 2. Setup Scroll Progress Reveal
    const totalWords = wordFills.length;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      wordFills.forEach((fill) => (fill.style.opacity = '1'));
      return;
    }

    // The reveal is driven by scroll position, but a raw scroll→opacity map
    // makes fast scrolling "skip": between two frames the wheel can jump the
    // progress far enough that a whole run of words snaps from 0 to full at
    // once. Instead we keep a smoothed `displayed` progress that eases toward
    // the scroll-derived `target` every frame, so even a large jump resolves
    // as a continuous sweep.
    let targetProgress = 0;
    let displayedProgress = 0;
    let revealFrameId: number | null = null;
    let lastRevealTime = 0;

    function computeTargetProgress() {
      if (!track) return 0;
      const rect = track.getBoundingClientRect();
      const scrollableDistance = rect.height - window.innerHeight;
      if (scrollableDistance <= 0) return 0;
      const scrolled = -rect.top;
      return Math.max(0, Math.min(1, scrolled / scrollableDistance));
    }

    function renderWords(progress: number) {
      wordFills.forEach((fill, index) => {
        const start = 0.15 + (index / totalWords) * 0.7;
        const end = start + (1 / totalWords) * 0.7;
        const opacity = Math.max(0, Math.min(1, (progress - start) / (end - start)));
        fill.style.opacity = String(opacity);
      });
    }

    function revealLoop(time: number) {
      // Read the scroll target each frame so the loop tracks the wheel without
      // forcing a layout on every individual scroll event.
      targetProgress = computeTargetProgress();

      // Frame-rate independent easing: close a fixed fraction of the remaining
      // gap per second, so the sweep finishes in the same wall-clock time even
      // if the flickering-grid canvas drops us to a handful of fps.
      const dt = lastRevealTime === 0 ? 0.016 : Math.min(0.1, (time - lastRevealTime) / 1000);
      lastRevealTime = time;

      const diff = targetProgress - displayedProgress;
      if (Math.abs(diff) < 0.0004) {
        displayedProgress = targetProgress;
      } else {
        displayedProgress += diff * (1 - Math.exp(-9 * dt));
      }
      renderWords(displayedProgress);

      // Keep animating while easing; otherwise idle to avoid a permanent loop.
      if (displayedProgress !== targetProgress) {
        revealFrameId = requestAnimationFrame(revealLoop);
      } else {
        revealFrameId = null;
        lastRevealTime = 0;
      }
    }

    function onScroll() {
      if (revealFrameId === null) {
        revealFrameId = requestAnimationFrame(revealLoop);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    // Jump straight to the correct fill on first paint (no animated intro).
    displayedProgress = computeTargetProgress();
    targetProgress = displayedProgress;
    renderWords(displayedProgress);

    document.addEventListener(
      'astro:before-swap',
      () => {
        if (animationFrameId) cancelAnimationFrame(animationFrameId);
        if (revealFrameId !== null) cancelAnimationFrame(revealFrameId);
        resizeObserver.disconnect();
        intersectionObserver.disconnect();
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      },
      { once: true },
    );
  }

  initScrollRevealSection();
  document.addEventListener('astro:page-load', initScrollRevealSection);
</script>
