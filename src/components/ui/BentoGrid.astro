---
import Container from '@/components/ui/Container.astro';
import { t } from '@/config/strings';

interface CapabilityMeta {
  colSpan: string;
  icon: 'code' | 'layers' | 'server' | 'bot';
}

const metaList: CapabilityMeta[] = [
  { colSpan: 'md:col-span-7', icon: 'code' },
  { colSpan: 'md:col-span-5', icon: 'layers' },
  { colSpan: 'md:col-span-5', icon: 'server' },
  { colSpan: 'md:col-span-7', icon: 'bot' },
];

const capabilities = t.capabilities.items.map((item, index) => ({
  ...item,
  ...metaList[index],
}));
---

<section
  class="relative py-20 sm:py-28 overflow-hidden transition-colors duration-300"
  aria-labelledby="capabilities-title"
>
  <!-- Background SVG Dot Grid, masked top-to-bottom so it emerges from the manifesto -->
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 h-full w-full text-muted/25 dark:text-muted/30"
    style="mask-image: linear-gradient(to bottom, transparent, black 20%), radial-gradient(ellipse 95% 85% at 50% 50%, white 20%, transparent 90%); mask-composite: intersect; -webkit-mask-composite: source-in;"
  >
    <defs>
      <pattern id="bento-dot-pattern" width="28" height="28" patternUnits="userSpaceOnUse">
        <circle cx="1.5" cy="1.5" r="1.5" fill="currentColor"></circle>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#bento-dot-pattern)"></rect>
  </svg>

  <Container class="relative z-10">
    <!-- Centered Header -->
    <div class="mb-14 sm:mb-16 text-center">
      <span class="inline-flex items-center rounded-full px-3.5 py-1 text-xs font-mono font-medium border border-accent/30 bg-accent/5 text-accent mb-4 shadow-xs">
        {t.capabilities.tag}
      </span>
      <h2
        id="capabilities-title"
        class="mb-4 text-3xl font-extrabold text-fg sm:text-4xl lg:text-5xl tracking-tight"
      >
        {t.capabilities.title}
      </h2>
      <p class="mx-auto max-w-2xl text-base sm:text-lg text-muted leading-relaxed">
        {t.capabilities.description}
      </p>
    </div>

    <!-- Bento 12-Column Grid (Asymmetric 7/5 & 5/7) -->
    <div class="grid gap-5 sm:gap-6 grid-cols-1 md:grid-cols-12">
      {capabilities.map((item) => (
        <div
          class:list={[
            'group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-border/80 bg-surface/80 dark:bg-surface/50 backdrop-blur-md p-7 sm:p-8 transition-[border-color,box-shadow,transform] duration-500 hover:border-accent/40 hover:shadow-xl hover:shadow-accent/5 hover:-translate-y-0.5',
            item.colSpan,
          ]}
        >
          <!-- Glowing Corner Radial Blob on Hover -->
          <div
            class="pointer-events-none absolute -right-12 -top-12 h-48 w-48 rounded-full bg-accent/10 blur-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            aria-hidden="true"
          />

          <!-- SVG Fractal Noise Grain Texture Overlay (Enhanced tactile visibility) -->
          <div
            class="pointer-events-none absolute inset-0 z-0 opacity-[0.20] dark:opacity-[0.30] mix-blend-overlay bg-[size:160px_160px]"
            style="background-image:url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E&quot;)"
            aria-hidden="true"
          />

          <!-- Top: Transforming Icon Box -->
          <div class="relative z-10 flex items-center justify-between gap-4 mb-6">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-accent/10 text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-accent-fg group-hover:scale-105 shadow-xs border border-accent/20">
              {item.icon === 'code' && (
                <svg
                  class="h-7 w-7"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="16 18 22 12 16 6" />
                  <polyline points="8 6 2 12 8 18" />
                </svg>
              )}
              {item.icon === 'layers' && (
                <svg
                  class="h-7 w-7"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polygon points="12 2 2 7 12 12 22 7 12 2" />
                  <polyline points="2 17 12 22 22 17" />
                  <polyline points="2 12 12 17 22 12" />
                </svg>
              )}
              {item.icon === 'server' && (
                <svg
                  class="h-7 w-7"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="2" y="2" width="20" height="8" rx="2" ry="2" />
                  <rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
                  <line x1="6" y1="6" x2="6.01" y2="6" />
                  <line x1="6" y1="18" x2="6.01" y2="18" />
                </svg>
              )}
              {item.icon === 'bot' && (
                <svg
                  class="h-7 w-7"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="11" width="18" height="10" rx="2" />
                  <circle cx="12" cy="5" r="2" />
                  <path d="M12 7v4" />
                  <line x1="8" y1="16" x2="8" y2="16" />
                  <line x1="16" y1="16" x2="16" y2="16" />
                </svg>
              )}
            </div>
          </div>

          <!-- Middle: Card Content -->
          <div class="relative z-10 space-y-3">
            <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-fg group-hover:text-accent transition-colors">
              {item.title}
            </h3>
            <p class="text-muted text-sm sm:text-base leading-relaxed font-normal max-w-[95%] sm:max-w-[90%]">
              {item.description}
            </p>
          </div>

          <!-- Bottom: Stack Pills -->
          <div class="relative z-10 flex flex-wrap gap-1.5 pt-5 mt-6 border-t border-border/40">
            {item.stack.map((s) => (
              <span class="rounded-md border border-border/60 bg-surface/90 dark:bg-surface/70 px-2 py-0.5 font-mono text-[11px] text-muted transition-colors group-hover:border-accent/25 group-hover:text-fg/90">
                {s}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>
