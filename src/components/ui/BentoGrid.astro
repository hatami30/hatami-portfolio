---
interface Capability {
  num: string;
  title: string;
  tagline: string;
  description: string;
  stack: string[];
  colSpan: string;
  icon: 'cpu' | 'layout' | 'bot' | 'shield';
}

const capabilities: Capability[] = [
  {
    num: '01',
    title: 'Low-Latency Systems & Backend',
    tagline: 'HIGH PERFORMANCE & STABILITY',
    description:
      'Designing bulletproof backend architectures, optimizing relational queries, implementing Redis caching layers, and keeping API response times consistently under 150ms under peak traffic.',
    stack: ['Node.js', 'Fastify / Express', 'PostgreSQL', 'Redis', 'Docker'],
    colSpan: 'md:col-span-7',
    icon: 'cpu',
  },
  {
    num: '02',
    title: 'Modern Full-Stack & Edge Architecture',
    tagline: 'STATIC SPEED & GLOBAL RUNTIME',
    description:
      'Building type-safe, hyper-optimized web apps that ship minimal client JavaScript, load in sub-second times globally, and eliminate layout shift completely.',
    stack: ['Astro', 'TypeScript', 'Tailwind CSS', 'Vercel Edge'],
    colSpan: 'md:col-span-5',
    icon: 'layout',
  },
  {
    num: '03',
    title: 'Autonomous AI Agents & Workflows',
    tagline: 'INTELLIGENT AUTOMATION',
    description:
      'Developing structured LLM tool-calling pipelines, deterministic evaluation loops, and resilient background workers that automate complex multi-step technical workflows.',
    stack: ['Tool Calling', 'Model Context Protocol', 'Vector Search', 'RAG'],
    colSpan: 'md:col-span-5',
    icon: 'bot',
  },
  {
    num: '04',
    title: 'Tactile UI & Design Systems',
    tagline: 'WCAG AA & MICRO-INTERACTIONS',
    description:
      'Creating high-craft design systems with strict keyboard operability, zero flashes on theme toggle, fluid typography, and delightful, tactile state responses.',
    stack: ['WCAG 2.2 AA', 'Design Tokens', 'Semantic HTML', 'Fluid Typography'],
    colSpan: 'md:col-span-7',
    icon: 'shield',
  },
];
---

<section class="py-16 sm:py-24" aria-labelledby="capabilities-title">
  <div class="mb-12">
    <div class="inline-flex items-center gap-2 rounded-full border border-border/70 bg-surface/80 px-3.5 py-1 text-xs font-mono font-medium text-accent backdrop-blur-md mb-3">
      <span>SERVICES & CAPABILITIES</span>
    </div>
    <h2 id="capabilities-title" class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
      What I Build & Engineer
    </h2>
    <p class="text-muted mt-3 max-w-[62ch] text-base sm:text-lg leading-relaxed">
      A foundation in core software engineering principles, low-latency architectures, and precision craftsmanship across the entire stack.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-6">
    {
      capabilities.map((item) => (
        <div
          class:list={[
            'card-interactive group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-border/80 bg-surface/70 p-7 sm:p-8 backdrop-blur-md transition-all duration-300 hover:border-accent/60',
            item.colSpan,
          ]}
        >
          <!-- SVG Noise Grain Texture -->
          <div
            class="pointer-events-none absolute inset-0 z-0 opacity-[0.03] dark:opacity-[0.06] mix-blend-overlay"
            style="background-image:url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E&quot;)"
            aria-hidden="true"
          />

          <!-- Monolithic Watermark Number -->
          <div
            class="pointer-events-none absolute -bottom-6 -right-2 font-mono text-[7rem] sm:text-[9rem] font-extrabold leading-none text-foreground/5 dark:text-foreground/5 select-none transition-all duration-500 group-hover:text-accent/10 group-hover:-translate-y-2 group-hover:scale-105"
            aria-hidden="true"
          >
            {item.num}
          </div>

          <!-- Top: Icon & Category Tagline -->
          <div class="relative z-10 flex items-center justify-between gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-border/80 bg-surface shadow-xs transition-transform duration-300 group-hover:scale-110 group-hover:border-accent/40">
              {item.icon === 'cpu' && (
                <svg class="h-6 w-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="4" y="4" width="16" height="16" rx="2" />
                  <rect x="9" y="9" width="6" height="6" />
                  <line x1="9" y1="1" x2="9" y2="4" />
                  <line x1="15" y1="1" x2="15" y2="4" />
                  <line x1="9" y1="20" x2="9" y2="23" />
                  <line x1="15" y1="20" x2="15" y2="23" />
                  <line x1="20" y1="9" x2="23" y2="9" />
                  <line x1="20" y1="15" x2="23" y2="15" />
                  <line x1="1" y1="9" x2="4" y2="9" />
                  <line x1="1" y1="15" x2="4" y2="15" />
                </svg>
              )}
              {item.icon === 'layout' && (
                <svg class="h-6 w-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                  <line x1="3" y1="9" x2="21" y2="9" />
                  <line x1="9" y1="21" x2="9" y2="9" />
                </svg>
              )}
              {item.icon === 'bot' && (
                <svg class="h-6 w-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="10" rx="2" />
                  <circle cx="12" cy="5" r="2" />
                  <path d="M12 7v4" />
                  <line x1="8" y1="16" x2="8" y2="16" />
                  <line x1="16" y1="16" x2="16" y2="16" />
                </svg>
              )}
              {item.icon === 'shield' && (
                <svg class="h-6 w-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
              )}
            </div>

            <span class="font-mono text-[10px] tracking-widest uppercase text-muted">
              {item.tagline}
            </span>
          </div>

          <!-- Middle: Content -->
          <div class="relative z-10 my-6">
            <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-fg group-hover:text-accent transition-colors">
              {item.title}
            </h3>
            <p class="text-muted mt-2.5 text-sm leading-relaxed max-w-[55ch]">
              {item.description}
            </p>
          </div>

          <!-- Bottom: Stack Pills -->
          <div class="relative z-10 flex flex-wrap gap-1.5 pt-2 border-t border-border/40">
            {item.stack.map((s) => (
              <span class="rounded-md border border-border/60 bg-surface/80 px-2 py-0.5 font-mono text-[11px] text-muted">
                {s}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
