---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Deterministic coordinate offsets for ambient shimmering grid squares
const gridSquares = [
  { x: 3, y: 2, delay: '0s', duration: '4.2s' },
  { x: 6, y: 5, delay: '1.4s', duration: '5.1s' },
  { x: 11, y: 3, delay: '2.8s', duration: '4.0s' },
  { x: 4, y: 8, delay: '0.6s', duration: '5.6s' },
  { x: 14, y: 6, delay: '3.2s', duration: '4.5s' },
  { x: 18, y: 4, delay: '1.7s', duration: '6.2s' },
  { x: 9, y: 10, delay: '2.5s', duration: '4.8s' },
  { x: 15, y: 11, delay: '0.9s', duration: '5.3s' },
  { x: 2, y: 11, delay: '2.1s', duration: '4.7s' },
  { x: 21, y: 8, delay: '1.2s', duration: '5.9s' },
  { x: 25, y: 3, delay: '3.5s', duration: '4.4s' },
  { x: 28, y: 7, delay: '0.3s', duration: '5.0s' },
  { x: 23, y: 12, delay: '2.7s', duration: '6.1s' },
  { x: 32, y: 5, delay: '1.9s', duration: '4.3s' },
  { x: 35, y: 9, delay: '0.7s', duration: '5.4s' },
  { x: 7, y: 13, delay: '3.0s', duration: '4.6s' },
  { x: 19, y: 14, delay: '1.6s', duration: '5.2s' },
  { x: 29, y: 11, delay: '2.3s', duration: '4.9s' },
  { x: 12, y: 1, delay: '0.8s', duration: '5.7s' },
  { x: 38, y: 4, delay: '2.4s', duration: '6.0s' },
  { x: 16, y: 9, delay: '3.6s', duration: '4.1s' },
  { x: 27, y: 2, delay: '1.1s', duration: '5.5s' },
  { x: 34, y: 12, delay: '0.2s', duration: '4.8s' },
  { x: 5, y: 15, delay: '2.9s', duration: '5.3s' },
  { x: 31, y: 1, delay: '1.3s', duration: '4.9s' },
  { x: 10, y: 7, delay: '2.2s', duration: '5.8s' },
  { x: 22, y: 5, delay: '0.5s', duration: '4.2s' },
  { x: 36, y: 6, delay: '3.3s', duration: '5.1s' },
  { x: 13, y: 12, delay: '1.0s', duration: '6.3s' },
  { x: 26, y: 9, delay: '2.6s', duration: '4.7s' },
];
---

<div
  class:list={[
    'hero-background pointer-events-none absolute inset-0 overflow-hidden select-none z-0',
    className,
  ]}
  aria-hidden="true"
>
  <!-- 1. Ambient Vertical Gradient Tint -->
  <div class="absolute inset-0 bg-linear-to-b from-accent/5 via-transparent to-transparent"></div>

  <!-- 2. Dual Glow Orbs (Top-Left & Bottom-Right) -->
  <div class="absolute -top-24 left-0 h-96 w-96 -translate-x-1/3 rounded-full bg-accent/10 blur-[130px] transform-gpu"></div>
  <div class="absolute -bottom-20 right-0 h-80 w-80 translate-x-1/4 rounded-full bg-accent/5 blur-[110px] transform-gpu"></div>

  <!-- 3. Animated Grid Pattern with Radial Mask -->
  <div class="grid-mask absolute inset-0">
    <svg class="h-full w-full text-fg/10" xmlns="http://www.w3.org/2000/svg" fill="none">
      <defs>
        <pattern
          id="hero-grid-pattern"
          width="40"
          height="40"
          patternUnits="userSpaceOnUse"
          x="-1"
          y="-1"
        >
          <path
            d="M.5 40V.5H40"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            stroke-opacity="0.8"
          ></path>
        </pattern>
      </defs>

      <!-- Base Grid Lines -->
      <rect width="100%" height="100%" fill="url(#hero-grid-pattern)"></rect>

      <!-- Ambient Shimmering Accent Cells: fade in place, no stroke, no scale -->
      <svg x="-1" y="-1" class="overflow-visible">
        {gridSquares.map((sq) => (
          <rect
            width="39"
            height="39"
            x={sq.x * 40 + 1}
            y={sq.y * 40 + 1}
            class="grid-square-pulse fill-accent/15"
            stroke="none"
            stroke-width="0"
            style={`animation-delay: ${sq.delay}; animation-duration: ${sq.duration};`}
          />
        ))}
      </svg>
    </svg>
  </div>
</div>

<style>
  .grid-mask {
    -webkit-mask-image: radial-gradient(
      ellipse 70% 60% at 50% 40%,
      rgba(0, 0, 0, 1) 30%,
      transparent 80%
    );
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, rgba(0, 0, 0, 1) 30%, transparent 80%);
  }

  @keyframes grid-pulse {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 0.75;
    }
  }

  .grid-square-pulse {
    animation: grid-pulse ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .grid-square-pulse {
      animation: none;
      opacity: 0.2;
    }
  }
</style>
