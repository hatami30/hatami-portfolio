---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

/**
 * Deterministic grid cells for the ambient shimmer. Same structure as the reference
 * AnimatedGridPattern: a full-bleed line grid plus individual squares that only fade in
 * place (no scale, no travel along the lines), 30 of them, staggered like `delay: index * 0.1`.
 */
const gridSquares = [
  { x: 3, y: 2, delay: '0s' },
  { x: 6, y: 5, delay: '0.1s' },
  { x: 11, y: 3, delay: '0.2s' },
  { x: 4, y: 8, delay: '0.3s' },
  { x: 14, y: 6, delay: '0.4s' },
  { x: 18, y: 4, delay: '0.5s' },
  { x: 9, y: 10, delay: '0.6s' },
  { x: 15, y: 11, delay: '0.7s' },
  { x: 2, y: 11, delay: '0.8s' },
  { x: 21, y: 8, delay: '0.9s' },
  { x: 25, y: 3, delay: '1.0s' },
  { x: 28, y: 7, delay: '1.1s' },
  { x: 23, y: 12, delay: '1.2s' },
  { x: 32, y: 5, delay: '1.3s' },
  { x: 35, y: 9, delay: '1.4s' },
  { x: 7, y: 13, delay: '1.5s' },
  { x: 19, y: 14, delay: '1.6s' },
  { x: 29, y: 11, delay: '1.7s' },
  { x: 12, y: 1, delay: '1.8s' },
  { x: 38, y: 4, delay: '1.9s' },
  { x: 16, y: 9, delay: '2.0s' },
  { x: 27, y: 2, delay: '2.1s' },
  { x: 34, y: 12, delay: '2.2s' },
  { x: 5, y: 15, delay: '2.3s' },
  { x: 31, y: 1, delay: '2.4s' },
  { x: 10, y: 7, delay: '2.5s' },
  { x: 22, y: 5, delay: '2.6s' },
  { x: 36, y: 6, delay: '2.7s' },
  { x: 13, y: 12, delay: '2.8s' },
  { x: 26, y: 9, delay: '2.9s' },
];
---

<div
  class:list={[
    'hero-background pointer-events-none absolute inset-0 overflow-hidden select-none z-0',
    className,
  ]}
  aria-hidden="true"
>
  <!-- 1. Ambient vertical gradient tint -->
  <div class="absolute inset-0 bg-linear-to-b from-accent/5 via-transparent to-transparent"></div>

  <!-- 2. Dual glow orbs (top-left, bottom-right), sized to the reference composition -->
  <div class="absolute top-1/4 left-0 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-accent/10 blur-[140px] transform-gpu"></div>
  <div class="absolute right-0 bottom-10 h-96 w-96 translate-x-1/3 rounded-full bg-accent/5 blur-[120px] transform-gpu"></div>

  <!-- 3. Line grid + fading squares, masked to a 500px circle at the centre -->
  <div class="grid-mask absolute inset-0">
    <svg class="h-full w-full text-fg/10" xmlns="http://www.w3.org/2000/svg" fill="none">
      <defs>
        <pattern
          id="hero-grid-pattern"
          width="40"
          height="40"
          patternUnits="userSpaceOnUse"
          x="-1"
          y="-1"
        >
          <path
            d="M.5 40V.5H40"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            stroke-opacity="0.8"
          ></path>
        </pattern>
      </defs>

      <!-- Base grid lines -->
      <rect width="100%" height="100%" fill="url(#hero-grid-pattern)"></rect>

      <!-- Squares fade in place: no stroke, no transform, no travel along the lines -->
      <svg x="-1" y="-1" class="overflow-visible">
        {gridSquares.map((sq) => (
          <rect
            width="39"
            height="39"
            x={sq.x * 40 + 1}
            y={sq.y * 40 + 1}
            class="grid-square-pulse fill-accent"
            stroke="none"
            stroke-width="0"
            style={`animation-delay: ${sq.delay};`}
          />
        ))}
      </svg>
    </svg>
  </div>
</div>

<style>
  .grid-mask {
    -webkit-mask-image: radial-gradient(500px circle at center, rgba(0, 0, 0, 1), transparent);
    mask-image: radial-gradient(500px circle at center, rgba(0, 0, 0, 1), transparent);
  }

  /* 3s fade + 1s rest, matching the reference's duration/repeatDelay cadence. */
  @keyframes grid-pulse {
    0%,
    100% {
      opacity: 0;
    }
    15%,
    60% {
      opacity: 0.1;
    }
  }

  .grid-square-pulse {
    animation: grid-pulse 4s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .grid-square-pulse {
      animation: none;
      opacity: 0.1;
    }
  }
</style>
