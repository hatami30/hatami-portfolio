---
import { site } from '@/config/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const email = site.email.includes('[PLACEHOLDER') ? 'hello@hatami.tech' : site.email;
---

<button
  type="button"
  data-email={site.email}
  class:list={[
    'copy-email-btn border-border/80 bg-surface/80 text-muted hover:border-accent/50 hover:text-fg group inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-xl border px-3.5 font-mono text-xs backdrop-blur-xs transition-colors',
    className,
  ]}
  aria-label={`Copy email address ${email}`}
  title="Copy email address"
>
  <!-- Icon swaps on success: a real state change rather than a glyph appended to text. -->
  <svg
    class="copy-email-icon-copy text-accent h-3.5 w-3.5 shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
  </svg>
  <svg
    class="copy-email-icon-done hidden h-3.5 w-3.5 shrink-0 text-emerald-600 dark:text-emerald-400"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="20 6 9 17 4 12"></polyline>
  </svg>

  <span class="copy-email-label max-w-[180px] truncate">{email}</span>

  <!-- Confirmation is announced, not drawn into the label, so the address stays readable. -->
  <span class="copy-email-status sr-only" role="status" aria-live="polite"></span>
</button>

<script>
  function setupCopyEmailButtons() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.copy-email-btn');

    buttons.forEach((btn) => {
      if ((btn as unknown as { __copyBound?: boolean }).__copyBound) return;
      (btn as unknown as { __copyBound?: boolean }).__copyBound = true;

      const copyIcon = btn.querySelector<HTMLElement>('.copy-email-icon-copy');
      const doneIcon = btn.querySelector<HTMLElement>('.copy-email-icon-done');
      const status = btn.querySelector<HTMLElement>('.copy-email-status');
      if (!copyIcon || !doneIcon) return;

      let resetTimer: number | undefined;

      btn.addEventListener('click', async () => {
        const email = btn.getAttribute('data-email');
        const textToCopy = email && !email.includes('[PLACEHOLDER') ? email : 'hello@hatami.tech';

        try {
          await navigator.clipboard.writeText(textToCopy);
          copyIcon.classList.add('hidden');
          doneIcon.classList.remove('hidden');
          btn.classList.add('border-emerald-500/50');
          if (status) status.textContent = 'Email address copied to clipboard';

          window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            copyIcon.classList.remove('hidden');
            doneIcon.classList.add('hidden');
            btn.classList.remove('border-emerald-500/50');
            if (status) status.textContent = '';
          }, 2000);
        } catch {
          // Clipboard blocked (insecure context or denied): surface the address instead.
          if (status) status.textContent = textToCopy;
        }
      });
    });
  }

  setupCopyEmailButtons();
  document.addEventListener('astro:page-load', setupCopyEmailButtons);
</script>
