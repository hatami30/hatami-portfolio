---
// Interactive Command Palette (Cmd+K / Ctrl+K)
// Pure semantic HTML dialog, zero framework dependencies, fully keyboard operable.
import { site } from '@/config/site';
---

<dialog
  id="command-palette-dialog"
  aria-label="Command palette"
  class="fixed inset-0 z-50 m-auto w-full max-w-lg rounded-2xl border border-border/80 bg-surface/95 p-0 text-fg shadow-2xl backdrop-blur-xl backdrop:bg-black/60 backdrop:backdrop-blur-xs open:animate-in open:fade-in open:zoom-in-95"
>
  <div class="flex flex-col overflow-hidden">
    <!-- Search Input Bar -->
    <div class="flex items-center gap-3 border-b border-border/60 px-4 py-3.5">
      <svg
        class="h-4 w-4 text-muted shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="palette-input"
        type="text"
        placeholder="Type a command or jump to page..."
        aria-label="Search commands and destinations"
        autocomplete="off"
        spellcheck="false"
        class="w-full bg-transparent text-sm outline-hidden placeholder:text-muted/60"
      />
      <kbd class="rounded-md border border-border/80 bg-surface px-1.5 py-0.5 font-mono text-[10px] text-muted">
        ESC
      </kbd>
    </div>

    <!-- Command List -->
    <ul id="palette-list" class="max-h-72 overflow-y-auto p-2 text-xs" role="listbox">
      <li
        class="px-2.5 py-1 font-mono text-[10px] tracking-wider uppercase text-muted"
        role="presentation"
      >
        Navigation
      </li>
      <li role="presentation">
        <a
          href="/"
          role="option"
          aria-selected="true"
          tabindex="-1"
          class="palette-item flex min-h-11 items-center justify-between rounded-lg px-2.5 py-2 hover:bg-accent/10 hover:text-accent transition-colors"
        >
          <span class="flex items-center gap-2">
            <span class="font-mono text-muted">01</span>
            <span class="font-medium">Home Page</span>
          </span>
          <span class="font-mono text-[10px] text-muted">Jump ↵</span>
        </a>
      </li>
      <li role="presentation">
        <a
          href="/projects"
          role="option"
          aria-selected="false"
          tabindex="-1"
          class="palette-item flex min-h-11 items-center justify-between rounded-lg px-2.5 py-2 hover:bg-accent/10 hover:text-accent transition-colors"
        >
          <span class="flex items-center gap-2">
            <span class="font-mono text-muted">02</span>
            <span class="font-medium">Projects & Case Studies</span>
          </span>
          <span class="font-mono text-[10px] text-muted">Jump ↵</span>
        </a>
      </li>
      <li role="presentation">
        <a
          href="/blog"
          role="option"
          aria-selected="false"
          tabindex="-1"
          class="palette-item flex min-h-11 items-center justify-between rounded-lg px-2.5 py-2 hover:bg-accent/10 hover:text-accent transition-colors"
        >
          <span class="flex items-center gap-2">
            <span class="font-mono text-muted">03</span>
            <span class="font-medium">Technical Blog</span>
          </span>
          <span class="font-mono text-[10px] text-muted">Jump ↵</span>
        </a>
      </li>
      <li role="presentation">
        <a
          href="/about"
          role="option"
          aria-selected="false"
          tabindex="-1"
          class="palette-item flex min-h-11 items-center justify-between rounded-lg px-2.5 py-2 hover:bg-accent/10 hover:text-accent transition-colors"
        >
          <span class="flex items-center gap-2">
            <span class="font-mono text-muted">04</span>
            <span class="font-medium">About & Career</span>
          </span>
          <span class="font-mono text-[10px] text-muted">Jump ↵</span>
        </a>
      </li>
      <li role="presentation">
        <a
          href="/contact"
          role="option"
          aria-selected="false"
          tabindex="-1"
          class="palette-item flex min-h-11 items-center justify-between rounded-lg px-2.5 py-2 hover:bg-accent/10 hover:text-accent transition-colors"
        >
          <span class="flex items-center gap-2">
            <span class="font-mono text-muted">05</span>
            <span class="font-medium">Get in Touch</span>
          </span>
          <span class="font-mono text-[10px] text-muted">Jump ↵</span>
        </a>
      </li>

      <li
        class="mt-2 px-2.5 py-1 font-mono text-[10px] tracking-wider uppercase text-muted"
        role="presentation"
      >
        Quick Actions
      </li>
      <li role="presentation">
        <button
          id="palette-action-copy-email"
          type="button"
          role="option"
          aria-selected="false"
          tabindex="-1"
          data-email={site.email}
          class="palette-item flex min-h-11 w-full items-center justify-between rounded-lg px-2.5 py-2 text-left hover:bg-accent/10 hover:text-accent transition-colors cursor-pointer"
        >
          <span class="flex items-center gap-2">
            <svg
              class="h-3.5 w-3.5 text-muted"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-email-label" aria-live="polite" class="font-medium">
              Copy Direct Email
            </span>
          </span>
          <span class="font-mono text-[10px] text-muted">Action</span>
        </button>
      </li>
      <li role="presentation">
        <button
          id="palette-action-toggle-theme"
          type="button"
          role="option"
          aria-selected="false"
          tabindex="-1"
          class="palette-item flex min-h-11 w-full items-center justify-between rounded-lg px-2.5 py-2 text-left hover:bg-accent/10 hover:text-accent transition-colors cursor-pointer"
        >
          <span class="flex items-center gap-2">
            <svg
              class="h-3.5 w-3.5 text-muted"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
            </svg>
            <span class="font-medium">Toggle Dark / Light Theme</span>
          </span>
          <span class="font-mono text-[10px] text-muted">Switch</span>
        </button>
      </li>
    </ul>

    <!-- Footer Helper -->
    <div class="flex items-center justify-between border-t border-border/50 bg-surface/50 px-4 py-2.5 text-[11px] font-mono text-muted">
      <span>
        Navigate with <kbd class="rounded border border-border px-1">↑</kbd>{' '}
        <kbd class="rounded border border-border px-1">↓</kbd>
      </span>
      <span>
        Press <kbd class="rounded border border-border px-1">ESC</kbd> to close
      </span>
    </div>
  </div>
</dialog>

<script>
  function setupCommandPalette() {
    const dialog = document.getElementById('command-palette-dialog') as HTMLDialogElement | null;
    const input = document.getElementById('palette-input') as HTMLInputElement | null;
    const list = document.getElementById('palette-list');
    const copyBtn = document.getElementById('palette-action-copy-email');
    const copyLabel = document.getElementById('copy-email-label');
    const themeBtn = document.getElementById('palette-action-toggle-theme');

    if (!dialog || !input || !list) return;

    let activeIndex = 0;

    function getVisibleItems(): HTMLElement[] {
      return Array.from(list?.querySelectorAll<HTMLElement>('.palette-item') || []).filter(
        (item) => item.closest('li')?.style.display !== 'none',
      );
    }

    function updateActiveHighlight(items: HTMLElement[]) {
      items.forEach((item, idx) => {
        if (idx === activeIndex) {
          item.classList.add('bg-accent/15', 'text-accent');
          item.setAttribute('aria-selected', 'true');
        } else {
          item.classList.remove('bg-accent/15', 'text-accent');
          item.setAttribute('aria-selected', 'false');
        }
      });
    }

    function openPalette() {
      if (!dialog?.open) {
        dialog?.showModal();
        input?.focus();
        activeIndex = 0;
        updateActiveHighlight(getVisibleItems());
      }
    }

    function closePalette() {
      dialog?.close();
      if (input) input.value = '';
      filterItems('');
    }

    // Keyboard Navigation within Palette
    dialog.addEventListener('keydown', (e) => {
      const items = getVisibleItems();
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (items.length > 0) {
          activeIndex = (activeIndex + 1) % items.length;
          updateActiveHighlight(items);
          items[activeIndex]?.scrollIntoView({ block: 'nearest' });
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (items.length > 0) {
          activeIndex = (activeIndex - 1 + items.length) % items.length;
          updateActiveHighlight(items);
          items[activeIndex]?.scrollIntoView({ block: 'nearest' });
        }
      } else if (e.key === 'Enter') {
        const currentItem = items[activeIndex];
        if (currentItem) {
          e.preventDefault();
          currentItem.click();
        }
      }
    });

    // Close on backdrop click
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closePalette();
    });

    // Filter list
    function filterItems(query: string) {
      const q = query.toLowerCase().trim();
      const allItems = list?.querySelectorAll<HTMLElement>('.palette-item') || [];
      allItems.forEach((item) => {
        const text = item.textContent?.toLowerCase() || '';
        const li = item.closest('li');
        if (li) {
          li.style.display = text.includes(q) ? '' : 'none';
        }
      });
      activeIndex = 0;
      updateActiveHighlight(getVisibleItems());
    }

    input.addEventListener('input', () => filterItems(input.value));

    // Copy Email Action
    copyBtn?.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email');
      const textToCopy = email && !email.includes('[PLACEHOLDER') ? email : 'hello@hatami.tech';

      const settle = (label: string) => {
        if (copyLabel) copyLabel.textContent = label;
        setTimeout(() => {
          if (copyLabel) copyLabel.textContent = 'Copy Direct Email';
          closePalette();
        }, 1200);
      };

      try {
        await navigator.clipboard.writeText(textToCopy);
        settle('Email address copied');
      } catch {
        // Clipboard blocked (insecure context or denied): surface the address instead.
        settle('hello@hatami.tech');
      }
    });

    // Theme Toggle Action: delegate to canonical button
    themeBtn?.addEventListener('click', () => {
      const canonicalToggle = document.getElementById('theme-toggle');
      if (canonicalToggle) {
        canonicalToggle.click();
      } else {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
      }
      closePalette();
    });

    // Global listeners only registered once
    if (!(window as unknown as { __cmdPaletteBound?: boolean }).__cmdPaletteBound) {
      (window as unknown as { __cmdPaletteBound?: boolean }).__cmdPaletteBound = true;

      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          const currentDialog = document.getElementById(
            'command-palette-dialog',
          ) as HTMLDialogElement | null;
          if (currentDialog?.open) {
            currentDialog.close();
          } else {
            openPalette();
          }
        }
      });

      window.addEventListener('open-command-palette', openPalette);
    }
  }

  setupCommandPalette();
  document.addEventListener('astro:page-load', setupCommandPalette);
</script>
