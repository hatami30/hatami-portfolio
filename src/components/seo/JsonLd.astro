---
interface Props {
  data: object | object[];
}
const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
// "<" is escaped so content can never close the script tag early.
const serialize = (item: object) => JSON.stringify(item).replace(/</g, '\\u003c');
---

{items.map((item) => (
  <script type="application/ld+json" set:html={serialize(item)} />
))}
