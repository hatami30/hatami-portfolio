---
interface Props {
  tags: string[];
  class?: string;
}
const { tags, class: className } = Astro.props;
---

{tags.length > 0 && (
  <ul class:list={['flex flex-wrap gap-2 text-sm', className]}>
    {tags.map((tag) => (
      <li>
        <a
          href={`/blog/tag/${tag}`}
          class="border-border text-muted hover:border-accent hover:text-fg rounded-full border px-3 py-1 transition"
        >
          #{tag}
        </a>
      </li>
    ))}
  </ul>
)}
