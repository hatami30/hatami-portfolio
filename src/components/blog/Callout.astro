---
// MDX component: <Callout type="tip" title="Tip">Text</Callout>
interface Props {
  type?: 'note' | 'tip' | 'warning';
  title?: string;
}
const { type = 'note', title } = Astro.props;

const styles = {
  note: 'border-accent',
  tip: 'border-emerald-600 dark:border-emerald-400',
  warning: 'border-amber-600 dark:border-amber-400',
} as const;
---

<aside
  role="note"
  class:list={['not-prose bg-surface my-6 rounded-lg border-l-4 p-4', styles[type]]}
>
  {title && <p class="mb-1 font-semibold">{title}</p>}
  <div class="[&>p]:m-0">
    <slot />
  </div>
</aside>
