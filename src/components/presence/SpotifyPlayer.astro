---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  id="spotify-widget"
  class:list={[
    'spotify-container border-border/80 bg-surface/60 rounded-xl border px-3.5 py-2 text-xs backdrop-blur-xs transition-colors',
    className,
  ]}
>
  <div class="flex items-center gap-3">
    <!-- Equalizer / Icon -->
    <div class="relative flex h-5 w-5 shrink-0 items-center justify-center">
      <div id="spotify-equalizer" class="hidden items-end gap-[2px] h-3.5">
        <span class="eq-bar w-[3px] bg-emerald-500 rounded-xs h-full animate-[pulse_0.8s_ease-in-out_infinite]"></span>
        <span class="eq-bar w-[3px] bg-emerald-500 rounded-xs h-2/3 animate-[pulse_1.2s_ease-in-out_infinite_0.2s]"></span>
        <span class="eq-bar w-[3px] bg-emerald-500 rounded-xs h-4/5 animate-[pulse_0.9s_ease-in-out_infinite_0.4s]"></span>
      </div>
      <svg
        id="spotify-idle-icon"
        class="h-4 w-4 text-muted"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z" />
      </svg>
    </div>

    <!-- Song Details -->
    <div class="min-w-0 flex-1">
      <p id="spotify-status-text" class="truncate font-medium text-fg">
        <span class="text-muted">Not listening to Spotify</span>
      </p>
    </div>
  </div>
</div>

<script>
  async function fetchSpotify() {
    try {
      const res = await fetch('/api/spotify');
      if (!res.ok) return;
      const data = await res.json();

      const container = document.getElementById('spotify-widget');
      const eq = document.getElementById('spotify-equalizer');
      const idleIcon = document.getElementById('spotify-idle-icon');
      const statusText = document.getElementById('spotify-status-text');

      if (!statusText || !eq || !idleIcon || !container) return;

      if (data.isPlaying && data.title) {
        eq.classList.remove('hidden');
        eq.classList.add('flex');
        idleIcon.classList.add('hidden');

        statusText.innerHTML = `
          <a href="${data.songUrl || '#'}" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors flex items-center gap-1.5 truncate">
            <span class="font-semibold text-fg">${data.title}</span>
            <span class="text-muted text-[11px] font-mono">· ${data.artist}</span>
          </a>
        `;
        container.classList.add('border-emerald-500/30', 'bg-emerald-500/5');
      } else {
        eq.classList.remove('flex');
        eq.classList.add('hidden');
        idleIcon.classList.remove('hidden');
        statusText.innerHTML = '<span class="text-muted">Spotify idle / offline</span>';
        container.classList.remove('border-emerald-500/30', 'bg-emerald-500/5');
      }
    } catch {
      // Graceful degradation on network error
    }
  }

  fetchSpotify();
  // Poll every 30 seconds for live updates
  const interval = setInterval(fetchSpotify, 30000);
  document.addEventListener('astro:before-swap', () => clearInterval(interval));
</script>
