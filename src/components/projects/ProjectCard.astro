---
import { Image } from 'astro:assets';
import { t } from '@/config/strings';
import type { Project } from '@/lib/content';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, summary, stack, cover } = project.data;
---

<article class="card-interactive group border-border/80 bg-surface/50 hover:bg-surface hover:border-accent/60 relative flex h-full flex-col gap-3 rounded-2xl border p-5 sm:p-6 transition-all duration-200 backdrop-blur-xs">
  {cover ? (
    <div class="overflow-hidden rounded-xl border border-border/60">
      <Image
        src={cover}
        alt=""
        width={640}
        height={360}
        class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
      />
    </div>
  ) : (
    <div class="relative overflow-hidden rounded-xl border border-border/60 bg-surface/80 p-4 aspect-video flex flex-col justify-between group-hover:border-accent/40 transition-colors">
      <div class="flex items-center justify-between border-b border-border/40 pb-2">
        <div class="flex items-center gap-1.5">
          <span class="h-2 w-2 rounded-full bg-border"></span>
          <span class="h-2 w-2 rounded-full bg-border"></span>
          <span class="h-2 w-2 rounded-full bg-border"></span>
        </div>
        <span class="font-mono text-[10px] text-muted tracking-widest uppercase">
          Spec // Case Study
        </span>
      </div>
      <div class="py-2">
        <span class="font-mono text-xs text-accent font-semibold">{project.data.role}</span>
        <p class="font-mono text-[11px] text-muted truncate mt-0.5">
          {stack.slice(0, 3).join(' • ')}
        </p>
      </div>
      <div class="flex items-center justify-between text-[11px] font-mono text-muted border-t border-border/30 pt-2">
        <span>{project.data.period || 'Production'}</span>
        <span class="text-accent group-hover:translate-x-0.5 transition-transform">
          Read study ↗
        </span>
      </div>
    </div>
  )}
  <div class="flex items-baseline justify-between gap-2 pt-1">
    <h3 class="text-lg font-semibold tracking-tight group-hover:text-accent transition-colors">
      <a href={`/projects/${project.id}`} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>
    <span
      class="text-muted text-xs font-mono opacity-0 transition-opacity group-hover:opacity-100"
      aria-hidden="true"
    >
      →
    </span>
  </div>
  <p class="text-muted text-sm leading-relaxed">{summary}</p>
  <ul class="mt-auto flex flex-wrap gap-1.5 pt-2 text-xs" aria-label={t.projects.stack}>
    {stack.map((item) => (
      <li class="border-border/60 bg-surface text-muted rounded-md border px-2 py-0.5 font-mono text-[11px]">
        {item}
      </li>
    ))}
  </ul>
</article>
