---
import { site } from '@/config/site';
import { t } from '@/config/strings';
import { hasValue } from '@/lib/placeholder';
import Container from '@/components/ui/Container.astro';

const year = new Date().getFullYear();

/** The owner's role, shown only once it is real (never the bracketed placeholder). */
const role = hasValue(site.role) ? site.role : null;

/**
 * The giant wordmark is the brand word taken from the canonical host (hatami.tech -> "hatami"),
 * so it stays correct if the domain moves. It is rendered with a leading capital ("Hatami")
 * to read as a proper noun rather than a lower-case URL fragment. It is decorative: the name
 * is already in the copyright line, so the mark is aria-hidden rather than repeated to screen
 * readers.
 */
const brand = (() => {
  const word = (() => {
    try {
      return new URL(site.url).hostname.replace(/^www\./, '').split('.')[0];
    } catch {
      return site.name;
    }
  })();
  return word.charAt(0).toUpperCase() + word.slice(1);
})();

/** Brand marks are filled glyphs, not the house stroke icons: they must read as the real logo. */
const SOCIAL_PATHS: Record<'github' | 'linkedin', string> = {
  github:
    'M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.6 8.21 11.16.6.11.82-.25.82-.57v-2.2c-3.34.71-4.04-1.58-4.04-1.58-.55-1.37-1.34-1.74-1.34-1.74-1.09-.73.08-.72.08-.72 1.21.08 1.84 1.22 1.84 1.22 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.58-2.67-.3-5.47-1.31-5.47-5.83 0-1.29.47-2.34 1.24-3.17-.13-.3-.54-1.5.12-3.12 0 0 1.01-.32 3.3 1.21a11.5 11.5 0 0 1 3-.4c1.02 0 2.05.14 3 .4 2.29-1.53 3.3-1.21 3.3-1.21.66 1.62.25 2.82.12 3.12.77.83 1.24 1.88 1.24 3.17 0 4.53-2.81 5.53-5.49 5.82.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12.02 12.02 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z',
  linkedin:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z',
};

/** Only links with a real destination render (R-24/R-38): empty and placeholder values drop out. */
const socials = (
  [
    { label: 'GitHub', href: site.socials.github, icon: 'github' as const },
    { label: 'LinkedIn', href: site.socials.linkedin, icon: 'linkedin' as const },
  ] as const
).filter((s) => hasValue(s.href));

const elsewhere = [
  { label: 'GitHub', href: site.socials.github },
  { label: 'LinkedIn', href: site.socials.linkedin },
  { label: t.footer.resume, href: site.resumeUrl },
  { label: t.footer.email, href: hasValue(site.email) ? `mailto:${site.email}` : '' },
  { label: t.footer.rss, href: '/rss.xml' },
].filter((link) => hasValue(link.href));
---

<footer data-footer-beam class="relative">
  <!-- Ambient light: one language for the whole closing section (R-13), behind all content.
       The pool is centred on the footer's top edge, so its light blooms both up into the
       section above and down into the footer and the two read as one field rather than two
       stacked bands. The layer reaches above the footer but sits behind the page's own
       content, so no light lands on the section above's text, and it is clipped sideways so
       the drifting shaft never widens the page. -->
  <div class="footer-light pointer-events-none" aria-hidden="true">
    <div class="footer-seam"></div>
    <div class="footer-beam"></div>
  </div>

  <!-- Pointer glow: a soft pool that tracks the cursor, held to the footer's own box. -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="footer-glow"></div>
  </div>

  <Container class="relative">
    <div class="grid gap-10 pt-14 sm:pt-16 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr] lg:gap-12">
      <!-- Identity: copyright, role, and the glassy social buttons -->
      <div>
        <p class="text-fg text-sm font-medium">{t.footer.rights(year, site.name)}</p>
        {role && <p class="text-muted mt-1.5 text-sm">{role}</p>}

        {socials.length > 0 && (
          <ul class="mt-6 flex items-center gap-3">
            {socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  rel="me noopener"
                  target="_blank"
                  aria-label={social.label}
                  class="border-border/80 bg-surface/70 text-muted hover:border-accent/50 hover:text-fg flex h-10 w-10 items-center justify-center rounded-xl border backdrop-blur-md transition-colors"
                >
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={SOCIAL_PATHS[social.icon]} />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Navigate: the site's own routes, nothing that does not exist -->
      <nav aria-labelledby="footer-navigate">
        <h2 id="footer-navigate" class="text-accent font-mono text-xs tracking-wider uppercase">
          {t.footer.navigate}
        </h2>
        <ul class="mt-4 space-y-2.5">
          {site.nav.map((item) => (
            <li>
              <a href={item.href} class="text-muted hover:text-fg text-sm transition-colors">
                {t.nav[item.key]}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Elsewhere: off-site destinations plus the feed -->
      <nav aria-labelledby="footer-elsewhere">
        <h2 id="footer-elsewhere" class="text-accent font-mono text-xs tracking-wider uppercase">
          {t.footer.elsewhere}
        </h2>
        <ul class="mt-4 space-y-2.5">
          {elsewhere.map((link) => (
            <li>
              <a
                href={link.href}
                rel={link.href.startsWith('http') ? 'me noopener' : undefined}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                class="text-muted hover:text-fg text-sm transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </Container>

  <!-- Giant wordmark, cropped by the bottom edge so the closing section ends on the brand.
       Two stacked copies: a dim base, and a bright copy revealed only where the spotlights
       pass. The light therefore reads as falling on the letters, not merely behind them. -->
  <div
    class="footer-wordmark-wrap pointer-events-none relative mt-12 select-none overflow-hidden sm:mt-16"
    aria-hidden="true"
  >
    <span class="footer-wordmark-base block translate-y-[0.22em] px-4 text-center font-extrabold tracking-tighter whitespace-nowrap [font-size:clamp(4rem,22vw,15rem)] leading-none sm:px-6">
      {brand}
    </span>
    <!-- Parent carries the vertical crop fade; the child carries the two spotlight masks,
         so the two spotlight pools union and the fade clips them (no mask-composite needed). -->
    <div class="footer-wordmark-fade absolute inset-0">
      <span class="footer-wordmark-lit block translate-y-[0.22em] px-4 text-center font-extrabold tracking-tighter whitespace-nowrap [font-size:clamp(4rem,22vw,15rem)] leading-none sm:px-6">
        {brand}
      </span>
    </div>
  </div>
</footer>

<script>
  function setupFooterBeam() {
    const footer = document.querySelector<HTMLElement>('[data-footer-beam]');
    if (!footer) return;
    // Guard: astro:page-load can fire again on client navigation.
    if (footer.dataset.beamBound === 'true') return;
    footer.dataset.beamBound = 'true';

    // Motion is an enhancement: no listener at all when the visitor asked for calm.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const wrapEl = footer.querySelector<HTMLElement>('.footer-wordmark-wrap');
    if (!wrapEl) return;
    const wrap = wrapEl;
    const root = footer;

    // Two spotlights: the primary sits on the pointer, the secondary trails to the left.
    // Both ease toward their target so the light glides instead of snapping, and the
    // modest offset keeps both beams over the letters rather than drifting into empty space.
    const OFFSET_X = -16;
    const OFFSET_Y = 5;
    const target = { x: 50, y: 34 };
    const current = { x: 50, y: 34 };

    const clamp = (v: number) => Math.max(-10, Math.min(110, v));

    // Cache the wrap's box; refresh on the events that move it, so pointermove itself
    // never forces a layout read between the mask writes of the previous frame.
    let rect = wrap.getBoundingClientRect();
    const refreshRect = () => {
      rect = wrap.getBoundingClientRect();
    };

    let frame = 0;
    function tick() {
      current.x += (target.x - current.x) * 0.14;
      current.y += (target.y - current.y) * 0.14;

      const x2 = clamp(current.x + OFFSET_X);
      const y2 = clamp(current.y + OFFSET_Y);
      wrap.style.setProperty('--spot1-x', `${current.x}%`);
      wrap.style.setProperty('--spot1-y', `${current.y}%`);
      wrap.style.setProperty('--spot2-x', `${x2}%`);
      wrap.style.setProperty('--spot2-y', `${y2}%`);
      root.style.setProperty('--beam-x', `${current.x}%`);
      root.style.setProperty('--beam-y', `${current.y}%`);

      const settled =
        Math.abs(target.x - current.x) < 0.15 && Math.abs(target.y - current.y) < 0.15;
      frame = settled ? 0 : requestAnimationFrame(tick);
    }

    footer.addEventListener(
      'pointermove',
      (event) => {
        target.x = clamp(((event.clientX - rect.left) / rect.width) * 100);
        target.y = clamp(((event.clientY - rect.top) / rect.height) * 100);
        if (!frame) frame = requestAnimationFrame(tick);
      },
      { passive: true },
    );

    window.addEventListener('scroll', refreshRect, { passive: true });
    window.addEventListener('resize', refreshRect);

    // Start from the resting position so the mark is lit before the first pointer move.
    tick();
  }

  setupFooterBeam();
  document.addEventListener('astro:page-load', setupFooterBeam);
</script>

<style>
  [data-footer-beam] {
    --beam-x: 50%;
    --beam-y: 18%;
  }

  /* The whole closing section's light, in one layer. It begins above the footer's top edge
     so the pool can bloom across the join, and it paints behind the page's content: the
     footer is not a stacking context, so the negative z-index lifts this layer under the
     section above rather than over its text. Overflow is clipped so the drifting shaft can
     never widen the page. */
  .footer-light {
    position: absolute;
    left: 0;
    right: 0;
    top: -20rem;
    bottom: 0;
    z-index: -1;
    overflow: hidden;
  }

  /* Centred on the footer's top edge, so the light is continuous across the join: it falls
     away smoothly upward and downward, leaving no edge for the eye to catch. Kept faint so
     the accent-tinted text just below the join (the nav headings) still clears WCAG AA: at
     5% over 22rem the headings hold 4.61:1 (light) and 5.30:1 (dark). */
  .footer-seam {
    position: absolute;
    left: 50%;
    top: 20rem; /* the footer's top edge, measured inside this wrapper */
    width: 170%;
    height: 22rem;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle closest-side,
      color-mix(in oklab, var(--accent) 5%, transparent),
      transparent
    );
  }

  /* The diagonal shaft: one soft band of accent light, blurred, drifting slowly. */
  .footer-beam {
    position: absolute;
    inset: 0 -20% -40% -20%;
    background: linear-gradient(
      115deg,
      transparent 34%,
      color-mix(in oklab, var(--accent) 14%, transparent) 48%,
      color-mix(in oklab, var(--accent) 24%, transparent) 52%,
      transparent 66%
    );
    filter: blur(46px);
    will-change: transform;
    animation: footer-beam-drift 16s ease-in-out infinite alternate;
  }

  /* The pointer glow: a soft pool behind everything, giving the light a source. */
  .footer-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      360px circle at var(--beam-x) var(--beam-y),
      color-mix(in oklab, var(--accent) 12%, transparent),
      transparent 70%
    );
  }

  @keyframes footer-beam-drift {
    from {
      transform: translateX(-4%);
    }
    to {
      transform: translateX(4%);
    }
  }

  .footer-wordmark-wrap {
    --spot1-x: 50%;
    --spot1-y: 34%;
    --spot2-x: 20%;
    --spot2-y: 41%;
  }

  /* Base mark: the brand at rest, dim, under the top-down crop mask. */
  .footer-wordmark-base {
    color: color-mix(in oklab, var(--accent) 34%, var(--bg));
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 34%);
    mask-image: linear-gradient(to bottom, transparent, #000 34%);
  }

  /* Parent: the vertical crop fade, applied to the whole lit layer. */
  .footer-wordmark-fade {
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 34%);
    mask-image: linear-gradient(to bottom, transparent, #000 34%);
  }

  /* Lit mark: a bright copy revealed only inside the two spotlight pools, so the beams
     read as falling on the letters. Narrow tall ellipses read as beams, not blobs.
     Listing two radial masks unions them (default add). */
  .footer-wordmark-lit {
    color: var(--accent);
    -webkit-mask-image:
      radial-gradient(ellipse 9% 120% at var(--spot1-x) var(--spot1-y), #000 0%, transparent 70%),
      radial-gradient(ellipse 7% 115% at var(--spot2-x) var(--spot2-y), #000 0%, transparent 68%);
    mask-image:
      radial-gradient(ellipse 9% 120% at var(--spot1-x) var(--spot1-y), #000 0%, transparent 70%),
      radial-gradient(ellipse 7% 115% at var(--spot2-x) var(--spot2-y), #000 0%, transparent 68%);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-beam {
      animation: none;
      transform: none;
    }
  }
</style>
