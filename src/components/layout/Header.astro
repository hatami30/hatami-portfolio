---
import { site } from '@/config/site';
import { t } from '@/config/strings';
import Container from '@/components/ui/Container.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="border-border/60 bg-bg/80 sticky top-0 z-40 border-b backdrop-blur-md transition-colors">
  <Container class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3.5">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight hover:opacity-90">
      <span class="bg-accent/20 border-accent/40 text-accent flex h-7 w-7 items-center justify-center rounded-lg border text-xs font-mono font-bold">
        H
      </span>
      <span>{site.name}</span>
    </a>
    <div class="flex items-center gap-4">
      <nav aria-label={t.mainNav}>
        <ul class="flex items-center gap-1 sm:gap-2 text-sm">
          {site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="text-muted hover:text-fg aria-[current=page]:text-fg aria-[current=page]:bg-surface aria-[current=page]:border-border/80 inline-flex items-center min-h-[36px] rounded-md border border-transparent px-2.5 py-1 transition-colors"
              >
                {t.nav[item.key]}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="bg-border/60 h-4 w-px"></div>
      <button
        id="header-cmd-palette-btn"
        type="button"
        class="text-muted hover:text-fg hover:border-accent/80 border-border/70 bg-surface/80 hidden sm:inline-flex items-center gap-1.5 rounded-lg border px-2 py-1 font-mono text-xs transition-colors cursor-pointer"
        title="Open command palette (Cmd+K)"
        aria-label="Open command palette"
      >
        <span class="text-[10px]">⌘</span>
        <span>K</span>
      </button>
      <ThemeToggle />
    </div>
  </Container>
</header>

<script>
  function setupHeaderCmdBtn() {
    const btn = document.getElementById('header-cmd-palette-btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-command-palette'));
    });
  }

  setupHeaderCmdBtn();
  document.addEventListener('astro:page-load', setupHeaderCmdBtn);
</script>
