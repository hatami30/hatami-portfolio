---
import { site } from '@/config/site';
import { t } from '@/config/strings';
import ThemeToggle from './ThemeToggle.astro';
import Button from '@/components/ui/Button.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<header class="fixed top-0 left-0 right-0 z-50 pointer-events-none">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 mt-3 sm:mt-4">
    <!-- Floating Nav Pill -->
    <nav
      aria-label={t.mainNav}
      class="pointer-events-auto flex items-center justify-between rounded-full border border-border/80 bg-surface/85 px-4 sm:px-6 py-2.5 sm:py-3 shadow-xs backdrop-blur-xl transition-colors duration-200"
    >
      <!-- Left: Monogram Logo -->
      <a
        href="/"
        class="group flex shrink-0 items-center gap-2.5 font-semibold tracking-tight hover:opacity-95"
        aria-label={`${site.name} - Home`}
      >
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent/40 bg-accent/15 font-mono text-xs font-bold text-accent shadow-2xs transition-transform duration-200 group-hover:scale-105">
          H
        </span>
        <span class="text-fg max-w-[110px] truncate text-sm font-semibold tracking-tight sm:max-w-[160px] lg:max-w-none">
          {site.name}
        </span>
      </a>

      <!-- Center: Navigation Links (Desktop) -->
      <ul class="hidden items-center gap-5 text-sm md:flex lg:gap-8">
        {site.nav.map((item) => {
          const active = isActive(item.href);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'relative inline-flex items-center py-1 text-xs sm:text-sm font-medium transition-colors',
                  active ? 'text-fg font-semibold' : 'text-muted hover:text-fg',
                ]}
              >
                {t.nav[item.key]}
                {active && (
                  <span class="absolute -bottom-1 left-0 right-0 h-0.5 rounded-full bg-accent" />
                )}
              </a>
            </li>
          );
        })}
      </ul>

      <!-- Right: Action Controls (Desktop + Mobile Toggle) -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <!-- Command Palette Trigger (Desktop) -->
        <button
          id="header-cmd-palette-btn"
          type="button"
          class="text-muted hover:text-fg hover:border-accent/50 border-border/80 bg-surface/80 hidden min-h-11 cursor-pointer items-center gap-1.5 rounded-full border px-3 font-mono text-xs transition-colors sm:inline-flex"
          title="Open command palette (Cmd+K)"
          aria-label="Open command palette"
        >
          <span class="text-muted text-[10px]">⌘</span>
          <span class="text-xs">K</span>
        </button>

        <!-- Theme Toggle -->
        <ThemeToggle />

        <!-- CTA Contact Pill (Desktop only; the mobile menu carries its own full-size CTA).
             max-md:hidden rather than hidden+md:inline-flex: the base class already sets
             inline-flex, and two competing display utilities resolve by stylesheet order. -->
        <Button href="/contact" size="xs" shape="pill" class="max-md:hidden">
          {t.home.ctaContact}
        </Button>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-nav-toggle"
          type="button"
          class="text-fg hover:bg-surface/90 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full transition-colors md:hidden"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav-dropdown"
        >
          <!-- Hamburger icon -->
          <svg
            id="mobile-nav-icon-open"
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="18" x2="20" y2="18"></line>
          </svg>
          <!-- Close (X) icon -->
          <svg
            id="mobile-nav-icon-close"
            class="hidden h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Dropdown Panel -->
    <div
      id="mobile-nav-dropdown"
      class="hidden md:hidden pointer-events-auto mt-2 overflow-hidden rounded-2xl border border-border/80 bg-surface/95 p-5 shadow-xl backdrop-blur-2xl transition-all duration-200"
    >
      <ul class="flex flex-col gap-3 text-sm font-medium">
        {site.nav.map((item) => {
          const active = isActive(item.href);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center justify-between rounded-lg px-3 py-2 transition-colors',
                  active
                    ? 'bg-accent/15 text-accent font-semibold'
                    : 'text-muted hover:bg-surface/80 hover:text-fg',
                ]}
              >
                <span>{t.nav[item.key]}</span>
                {active && <span class="h-1.5 w-1.5 rounded-full bg-accent" />}
              </a>
            </li>
          );
        })}
      </ul>

      <div class="border-border/60 mt-4 flex items-center justify-between gap-3 border-t pt-4">
        <button
          id="mobile-cmd-palette-btn"
          type="button"
          class="border-border/80 bg-surface/80 text-muted hover:text-fg flex min-h-11 flex-1 cursor-pointer items-center justify-center gap-1.5 rounded-full border px-3 font-mono text-xs transition-colors"
        >
          <span class="text-[10px]">⌘</span>
          <span>K</span>
          <span class="text-fg ml-1 font-sans text-xs">Search</span>
        </button>
        <Button href="/contact" size="sm" shape="pill" class="flex-1">
          {t.home.ctaContact}
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  function setupHeaderInteractions() {
    const desktopCmdBtn = document.getElementById('header-cmd-palette-btn');
    const mobileCmdBtn = document.getElementById('mobile-cmd-palette-btn');
    const mobileToggle = document.getElementById('mobile-nav-toggle');
    const mobileDropdown = document.getElementById('mobile-nav-dropdown');
    const iconOpen = document.getElementById('mobile-nav-icon-open');
    const iconClose = document.getElementById('mobile-nav-icon-close');

    // 1. Command Palette Trigger
    function openPalette() {
      window.dispatchEvent(new CustomEvent('open-command-palette'));
    }

    desktopCmdBtn?.addEventListener('click', openPalette);
    mobileCmdBtn?.addEventListener('click', () => {
      closeMobileMenu();
      openPalette();
    });

    // 2. Mobile Nav Toggle
    function toggleMobileMenu() {
      if (!mobileDropdown || !mobileToggle) return;
      const isOpen = !mobileDropdown.classList.contains('hidden');

      if (isOpen) {
        closeMobileMenu();
      } else {
        mobileDropdown.classList.remove('hidden');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        mobileToggle.setAttribute('aria-expanded', 'true');
      }
    }

    function closeMobileMenu() {
      if (!mobileDropdown || !mobileToggle) return;
      mobileDropdown.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      mobileToggle.setAttribute('aria-expanded', 'false');
    }

    mobileToggle?.addEventListener('click', toggleMobileMenu);

    // Close on click outside
    document.addEventListener('click', (e) => {
      const target = e.target as Node | null;
      if (
        mobileDropdown &&
        !mobileDropdown.classList.contains('hidden') &&
        target &&
        !mobileDropdown.contains(target) &&
        !mobileToggle?.contains(target)
      ) {
        closeMobileMenu();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileDropdown && !mobileDropdown.classList.contains('hidden')) {
        closeMobileMenu();
        mobileToggle?.focus();
      }
    });
  }

  setupHeaderInteractions();
  document.addEventListener('astro:page-load', setupHeaderInteractions);
</script>
