---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import { t } from '@/config/strings';
import { formatDate } from '@/lib/format';
import { blogPostingJsonLd, breadcrumbJsonLd } from '@/lib/seo';
import type { Post, Project } from '@/lib/content';
import BaseLayout from './BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import TagList from '@/components/blog/TagList.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import TableOfContents from '@/components/blog/TableOfContents.astro';
import Giscus from '@/components/integrations/Giscus.astro';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  minutes: number;
  project?: Project;
  related?: Post[];
  newer?: Post;
  older?: Post;
}

const { post, headings, minutes, project, related = [], newer, older } = Astro.props;
const { title, description, date, updated, tags, cover } = post.data;
const path = `/blog/${post.id}`;
const image = `/og/blog/${post.id}.png`;
const crumbs = [
  { name: t.nav.blog, path: '/blog' },
  { name: title, path },
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={image}
  markdownPath={`${path}.md`}
  publishedTime={date}
  modifiedTime={updated ?? date}
  jsonLd={[
    blogPostingJsonLd({
      title,
      description,
      path,
      image,
      datePublished: date,
      dateModified: updated,
      tags,
      minutes,
    }),
    breadcrumbJsonLd(crumbs),
  ]}
>
  <Container class="py-12">
    <article data-pagefind-body class="mx-auto max-w-[70ch]">
      <Breadcrumbs items={crumbs} class="mb-6" />
      <header class="mb-8">
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
        <p class="text-muted mt-3 text-sm" data-pagefind-ignore>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {updated && (
            <>
              <span aria-hidden="true"> · </span>
              {t.blog.updated} <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
            </>
          )}
          <span aria-hidden="true"> · </span>
          {t.blog.readingTime(minutes)}
        </p>
        <TagList tags={tags} class="mt-4" />
      </header>

      {cover && (
        <Image
          src={cover}
          alt=""
          width={1200}
          height={630}
          class="mb-8 aspect-[1200/630] w-full rounded-xl object-cover"
        />
      )}

      <TableOfContents headings={headings} />

      <div class="prose">
        <slot />
      </div>

      {project && (
        <aside class="border-border mt-12 rounded-xl border p-5" data-pagefind-ignore>
          <p class="text-muted text-sm">{t.blog.relatedProject}</p>
          <a
            href={`/projects/${project.id}`}
            class="text-accent mt-1 inline-block font-medium underline underline-offset-4"
          >
            {project.data.title}
          </a>
        </aside>
      )}

      {related.length > 0 && (
        <section
          aria-labelledby="related-posts"
          class="border-border mt-12 border-t pt-8"
          data-pagefind-ignore
        >
          <h2 id="related-posts" class="text-xl font-semibold">
            {t.blog.relatedPosts}
          </h2>
          <ul class="mt-4 space-y-2">
            {related.map((item) => (
              <li>
                <a href={`/blog/${item.id}`} class="text-accent underline underline-offset-4">
                  {item.data.title}
                </a>
                <span class="text-muted text-sm"> · {formatDate(item.data.date)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {(newer || older) && (
        <nav
          aria-label="Posts"
          class="border-border mt-12 grid gap-6 border-t pt-6 text-sm sm:grid-cols-2"
          data-pagefind-ignore
        >
          <div>
            {newer && (
              <a href={`/blog/${newer.id}`} rel="next" class="group block">
                <span class="text-muted">← {t.blog.newer}</span>
                <span class="group-hover:text-accent mt-1 block font-medium">
                  {newer.data.title}
                </span>
              </a>
            )}
          </div>
          <div class="sm:text-right">
            {older && (
              <a href={`/blog/${older.id}`} rel="prev" class="group block">
                <span class="text-muted">{t.blog.older} →</span>
                <span class="group-hover:text-accent mt-1 block font-medium">
                  {older.data.title}
                </span>
              </a>
            )}
          </div>
        </nav>
      )}

      <Giscus />
    </article>
  </Container>
</BaseLayout>
